# ==============================================================================
# EMAIL-LOOKUP: ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# Never commit .env.local, .env.production, or active credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE AUTHENTICATION (NextAuth.js / Auth.js) - MANDATORY
# ------------------------------------------------------------------------------
# Required 32+ character random secret used to sign and encrypt JWTs and cookies.
# Generate via: openssl rand -base64 32   OR   npx auth secret
AUTH_SECRET="your-32-character-secret-key-goes-here-replace-me"

# Canonical URL of the application. Required for OAuth redirects in production.
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH & GMAIL READONLY API - MANDATORY FOR SMART DECLUTTER
# ------------------------------------------------------------------------------
# Created in Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Ensure the "Gmail API" is enabled in your Google Cloud Project.
# Required Scopes:
#   - openid
#   - email
#   - profile
#   - https://www.googleapis.com/auth/gmail.readonly
# Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-oauth-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# ------------------------------------------------------------------------------
# 3. GITHUB API TOKEN - OPTIONAL (HIGHLY RECOMMENDED FOR PUBLIC LOOKUP)
# ------------------------------------------------------------------------------
# Personal Access Token (classic or fine-grained with read:user scope).
# Increases GitHub API rate limit from 60 requests/hour (unauthenticated)
# to 5,000 requests/hour.
# Obtain from: https://github.com/settings/tokens
GITHUB_TOKEN=""

# ------------------------------------------------------------------------------
# 4. RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="development"
